// Cloudflare Workers, static assets only: the site is the public/ folder, served as it is.
{
  "name": "takku-app",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    // An unknown address gets public/404.html, with status 404.
    "not_found_handling": "404-page"
  }
}
